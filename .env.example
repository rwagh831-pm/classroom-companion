# Copy this file to a new file named ".env" and fill in your real values.
# The real ".env" is listed in .gitignore and must NEVER be committed.

# From @BotFather, when you created the Telegram bot:
BOT_TOKEN=your-telegram-bot-token-here

# Anthropic API key (for the language model).
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Public HTTPS URL of the Mini App server (e.g. your cloudflared tunnel URL, no trailing slash).
MINI_APP_URL=https://your-tunnel-url.trycloudflare.com
